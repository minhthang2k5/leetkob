# Copy this file to checker/.env (ignored by git) and fill in your local dev values.
# Never commit checker/.env or put real API keys in this template.

# --- Mode & Provider ---
# MODEL_OFF=1 disables all AI calls (hard rules only, semantic -> UNSURE)
MODEL_OFF=
# auto | gemini | anthropic (default: auto)
CHECKER_PROVIDER=auto

# --- API Keys & Models ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Guardrail, Cost Cap & Rate-Limit Pacing ---
# Max spend per lab in USD before blocking further AI calls (default: 3.0)
CHECKER_LAB_COST_CAP_USD=3.0
# Timeout per model call in ms (default: 30000; Gemini CLI default: 120000)
CHECKER_TIMEOUT_MS=30000
# Optional delay between CLI calls in ms (default: 6500 for Gemini, 0 for Anthropic)
CHECKER_DELAY_MS=
# Retry settings on HTTP 429 (Gemini CLI)
CHECKER_MAX_RETRIES=3
CHECKER_RETRY_DELAY_MS=15000
