# Names only: this file lists every variable and holds no values.
# Create your local .env with:  npm run init:env
# (it fills in the local development defaults; edit .env afterwards if you need to).

# Server
PORT=
NODE_ENV=

# PostgreSQL, development database (docker compose service "postgres")
DATABASE_URL=

# PostgreSQL, isolated test database; tests use only this one
TEST_DATABASE_URL=
