# Names only: this file lists every variable and holds no values.
# Create your local .env with:  npm run init:env
# (it fills in the local development defaults; edit .env afterwards if you need to).

# Server
PORT=
NODE_ENV=

# PostgreSQL, development database (docker compose service "postgres")
DATABASE_URL=

# PostgreSQL, isolated test database; tests use only this one
TEST_DATABASE_URL=

# Passwords of the deployed test accounts (npm run db:seed:accounts), at least 12 characters each.
# Set them only in the real environment; share them with the graders privately.
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_TA_A=
SEED_PASSWORD_TA_B=
SEED_PASSWORD_STUDENT_AN=
SEED_PASSWORD_STUDENT_BINH=
